{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "waqas-yousaf/dulluhan",
    "version": "0.3.6",
    "description": "A Laravel package for managing and publishing rich editorial posts, featuring headless Posts and Authors features.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Waqas Yousaf",
            "homepage": "https://github.com/waqas-yousaf/dulluhan"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/filesystem": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/routing": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/validation": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "WaqasYousaf\\Dulluhan\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "WaqasYousaf\\Dulluhan\\DulluhanServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
